# KnowledgeVault Configuration
# Copy this file to .env and customize the values
#
# Docker Compose forwarding contract (issue #494 CONFIG-007): every ACTIVE
# (uncommented) KEY= variable below is forwarded into the backend container's
# environment by docker-compose.yml as `- KEY=${KEY:-}`, so tuning a value
# here always reaches the containerized backend. Keep docker-compose.yml in
# sync when adding new variables. Intentional host-/build-time exceptions
# that are NOT forwarded to the backend service:
#   PORT                     host-side port mapping (in-container port is fixed)
#   VITE_APP_BASENAME        frontend build-time argument (Dockerfile build stage)
#   VITE_API_URL             frontend build-time argument (Dockerfile build stage)
#   HOST_DATA_DIR            host-side path of the data bind mount
#   WEB_CONCURRENCY          forwarded (default 1): drives the health
#                            module multi-worker cache guard
#   HF_TOKEN                 consumed by the harrier-embed sidecar container
# Credential-bearing keys (HEALTH_CHECK_API_KEY, IMAP_*) ARE forwarded with
# an empty default: unset means the feature stays off; values only ever come
# from this file (review F4, PR #576).
# Secrets (ADMIN_SECRET_TOKEN, JWT_SECRET_KEY) are forwarded explicitly by
# name in docker-compose.yml and never given implicit defaults.
# Guarded by backend/tests/test_issue494_compose_env_forwarding.py.

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Host-side port mapping in docker-compose ("${PORT:-9090}:9090").
# The in-container uvicorn listener is fixed at 9090 (see Dockerfile CMD);
# this only controls the port exposed on the Docker host. To change the
# internal listener, edit the Dockerfile CMD and update the healthcheck.
PORT=9090

# Public path prefix for reverse-proxy subpath deployments.
# Root deployment:
APP_ROOT_PATH=
VITE_APP_BASENAME=/
VITE_API_URL=
# When VITE_API_URL is empty it is derived from VITE_APP_BASENAME (e.g. /knowledgevault/api).
# Set explicitly only for a custom API URL such as an external gateway.
# Example for https://MEDXS.af.mil/knowledgevault/ with a prefix-stripping proxy:
# APP_ROOT_PATH=/knowledgevault
# VITE_APP_BASENAME=/knowledgevault
# VITE_API_URL=/knowledgevault/api
# FORWARDED_ALLOW_IPS=127.0.0.1

# Data Directory Configuration
# Host path for Docker volume mount - path on your host machine where data will be persisted
HOST_DATA_DIR=./data
# Container path for data storage - path inside the Docker container
DATA_DIR=/data/knowledgevault

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Admin Bearer token for protected admin/single-admin endpoints.
# Required for both USERS_ENABLED=true and USERS_ENABLED=false.
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_TOKEN=

# Rate limiting for admin endpoints (e.g., "10/minute")
ADMIN_RATE_LIMIT=10/minute

# Trust X-Forwarded-For header for rate limiter client IP identification.
# Set to true ONLY behind a trusted reverse proxy (nginx, Caddy, etc.).
# Default false to prevent IP spoofing.
TRUST_PROXY_HEADERS=false

# Health check API key for external monitoring. Authenticates the provider-
# probing health routes (deep=true, /llm-health/modes) since issue #551 and
# exempts them from rate limits. Leave EMPTY (fail-closed) unless you need
# key-based monitoring; generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HEALTH_CHECK_API_KEY=

# Rate limiting for the provider-probing health routes (deep health, LLM mode
# probe). These routes require authentication (user session or the
# HEALTH_CHECK_API_KEY credential) since issue #551.
HEALTH_PROBE_RATE_LIMIT=30/minute

# CSRF token time-to-live in seconds (default: 900 = 15 minutes)
CSRF_TOKEN_TTL=900

# Redis URL for CSRF token storage and caching
# Use "redis://localhost:6379/0" for local Redis
# In Docker: "redis://redis:6379/0"
REDIS_URL=redis://localhost:6379/0
# Issue #511: bounded timeout for optional Redis cache I/O on request paths (seconds).
#REDIS_IO_TIMEOUT_SECONDS=1

# CORS allowed origins (comma-separated list)
# For development: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Trusted proxy IPs for Uvicorn forwarded headers.
# Use "*" only inside a trusted private network where untrusted clients cannot connect directly.
FORWARDED_ALLOW_IPS=127.0.0.1

# Allowed Host header values for TrustedHostMiddleware (comma-separated).
# When set, requests with a Host header not in this list are rejected (400).
# Leave empty to disable (default — useful for local dev and bare-IP access).
# Example for production: ALLOWED_HOSTS=knowledgevault.example.com
ALLOWED_HOSTS=

# =============================================================================
# MULTI-USER AUTHENTICATION (JWT)
# =============================================================================
# Enable multi-user JWT authentication mode
USERS_ENABLED=true

# Secret key for JWT token signing (REQUIRED for JWT auth)
# The value below is intentionally rejected by app configuration; replace it before running.
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-string

# JWT signing algorithm — one of: HS256 (default), HS384, HS512.
# Other values fail closed at the FIRST token operation (not at startup).
# Rotating the algorithm invalidates tokens minted under the previous one.
JWT_ALGORITHM=HS256

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================
# URLs for embedding and chat services
# Harrier TEI service (docker-compose) or external embedding endpoint.
# A bare host:8080 URL (no path) selects native TEI mode (POST /embed); an
# explicit /v1/embeddings path selects OpenAI-compatible mode.
OLLAMA_EMBEDDING_URL=http://harrier-embed:8080/v1/embeddings
# Thinking chat endpoint — REQUIRED before chat works. Any OpenAI-compatible
# server works (Ollama, LM Studio, vLLM, remote API). Example:
# OLLAMA_CHAT_URL=http://192.168.1.50:11434
# Instant chat endpoint (optional; a second, faster endpoint). Example:
# INSTANT_CHAT_URL=http://192.168.1.50:1234

# SSRF guard opt-ins. Model/curator endpoints on a private/loopback/Docker
# network (e.g. the bundled harrier-embed/reranker, or a private model host like
# http://10.x / 172.16.x / 192.168.x) are blocked unless these are set to 1.
# The docker-compose deployment defaults ALLOW_LOCAL_SERVICES to 1 because the
# bundled services are private; set to 0 if every endpoint is public.
ALLOW_LOCAL_SERVICES=1
# Only needed if the wiki curator targets a private/loopback endpoint.
ALLOW_LOCAL_CURATOR=

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b

# Thinking chat model for higher-quality conversational responses
# Thinking model name as your endpoint knows it. Example:
# CHAT_MODEL=gemma4:26b

# Instant chat model for low-latency responses
# Instant model name. Example:
# INSTANT_CHAT_MODEL=minicpm5-2b
DEFAULT_CHAT_MODE=thinking
INSTANT_INITIAL_RETRIEVAL_TOP_K=10
INSTANT_RERANKER_TOP_N=4
INSTANT_MEMORY_CONTEXT_TOP_K=2
INSTANT_MAX_TOKENS=4096
# Maximum output tokens for the thinking (high-quality) chat mode. Default
# 32768 preserves the prior hardcoded budget; lower it to shrink the thinking
# token budget (issue #395 DD-rag-005).
THINKING_MAX_TOKENS=32768
# Per-mode HTTP request read timeouts in seconds (issue #652). Defaults preserve
# the prior hardcoded client constants. Streaming consumers get a per-chunk
# reset, so this bounds the longest chunk gap, not the total generation;
# restart required after a change. Raise for slow model deployments.
THINKING_REQUEST_TIMEOUT_SECONDS=300.0
EDITORIAL_REQUEST_TIMEOUT_SECONDS=300.0
INSTANT_REQUEST_TIMEOUT_SECONDS=120.0
# Instant-mode thinking switch (issue #494 FU-005): false (default) forces enable_thinking=False
# via chat_template_kwargs on every Instant request (correct for Gemma-4-style templates);
# true omits the kwarg so the model template default governs (future thinking-capable Instant models).
INSTANT_ENABLE_THINKING=false
# Provider residency/context contracts (issue #571). OLLAMA_KEEP_ALIVE is the
# Ollama keep_alive sent on the native preload call for the thinking/editorial
# backends: -1 keeps the model loaded (same as the retired ping loop), and
# duration strings like 30m also work. OLLAMA_NUM_CTX pins the loaded model's
# context window (4096 = Ollama's documented default). LM_STUDIO_TTL is the
# idle TTL in seconds carried on every Instant (LM Studio) chat payload — the
# timer resets per request, and LM Studio may still evict the model when a
# DIFFERENT model is requested (JIT Auto-Evict). LM_STUDIO_CONTEXT_LENGTH is
# requested from LM Studio's native load endpoint.
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_CTX=4096
LM_STUDIO_TTL=86400
LM_STUDIO_CONTEXT_LENGTH=4096
# Instant-mode latency skips: trade retrieval quality for speed in Instant mode
# only (Thinking mode keeps the full pipeline). Defaults match config.py.
INSTANT_SKIP_QUERY_TRANSFORMATION=true
INSTANT_SKIP_RETRIEVAL_EVALUATION=true
INSTANT_SKIP_DISTILLATION_SYNTHESIS=true
INSTANT_SKIP_FOLLOWUP_REWRITE=false

# Embedding dimension (auto-detected, but can be overridden)
# harrier-oss-v1-0.6b = 1024
EMBEDDING_DIM=1024

# HuggingFace Hub token (optional — Harrier is a public model, no auth required)
HF_TOKEN=

# Enable model validation on startup (checks if models are available in Ollama)
ENABLE_MODEL_VALIDATION=false

# =============================================================================
# DOCUMENT PROCESSING (NEW CHARACTER-BASED CONFIGURATION)
# =============================================================================
# Character-based chunk size (~4 chars per token)
# Default: 2000 chars (~500 tokens) - compatible with llama.cpp default batch size
CHUNK_SIZE_CHARS=2000

# Character-based overlap between chunks
# Default: 200 chars (~50 tokens overlap)
CHUNK_OVERLAP_CHARS=200

# Document parsing strategy for unstructured.io
# Options: "fast" (fastest), "hi_res" (best quality), "auto" (automatic)
DOCUMENT_PARSING_STRATEGY=fast

# =============================================================================
# RETRIEVAL CONFIGURATION
# =============================================================================
# Number of top chunks to retrieve for RAG context
# This is the canonical setting (replaces MAX_CONTEXT_CHUNKS and VECTOR_TOP_K)
RETRIEVAL_TOP_K=12

# Maximum distance threshold for relevance filtering
# For cosine distance: 0=identical, 1=orthogonal, 2=opposite
# Calibrated 2026-09 (issue #36) for the Harrier embedding scale: gold-result
# cosine distances center at ~0.61, so 0.75 keeps relevant results on
# non-rerank paths while still filtering the no-answer distribution.
MAX_DISTANCE_THRESHOLD=0.75

# Distance metric for vector similarity search
# Options: "cosine", "l2", "dot"
VECTOR_METRIC=cosine

# Window size for retrieval context expansion (fetches N adjacent chunks)
RETRIEVAL_WINDOW=1

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================
# Number of texts to send per embedding API request
# Higher values = better GPU utilization but more VRAM usage
EMBEDDING_BATCH_SIZE=64

# Maximum retries for adaptive batching when token overflow occurs
EMBEDDING_BATCH_MAX_RETRIES=3

# Minimum sub-batch size for adaptive batching fallback
EMBEDDING_BATCH_MIN_SUB_SIZE=1

# Optional prefixes for instruction-based embedding models (e.g., Qwen3)
# Leave empty for Harrier (uses symmetric retrieval, no prefixes needed)
EMBEDDING_DOC_PREFIX=
EMBEDDING_QUERY_PREFIX=

# =============================================================================
# RERANKER CONFIGURATION
# =============================================================================
# Enable cross-encoder reranking for better retrieval quality
RERANKING_ENABLED=true

# Reranker endpoint URL (TEI-compatible)
# In docker-compose this is set automatically to http://reranker:8081
RERANKER_URL=http://reranker:8081

# Reranker model (HuggingFace model ID)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Number of chunks to keep after reranking
RERANKER_TOP_N=7

# Initial retrieval count before reranking
INITIAL_RETRIEVAL_TOP_K=20

# =============================================================================
# HYBRID SEARCH CONFIGURATION
# =============================================================================
# Enable hybrid search: combines dense vector + BM25 keyword search
HYBRID_SEARCH_ENABLED=true

# Weight for dense vs BM25 scores in RRF fusion
# 0.0 = pure BM25, 1.0 = pure dense, 0.6 = prefer dense (default)
HYBRID_ALPHA=0.6

# =============================================================================
# OPT-IN RAG FEATURES (disabled by default below — enable per your needs)
# =============================================================================
# Phase 2: Contextual Chunking
CONTEXTUAL_CHUNKING_ENABLED=false
CONTEXTUAL_CHUNKING_CONCURRENCY=5

# Phase 3: Multi-Scale Chunk Indexing
# New deployments use fewer scales by default for faster initial indexing.
# Existing deployments can keep 512,1024,2048 if they need the prior footprint.
MULTI_SCALE_INDEXING_ENABLED=true
MULTI_SCALE_CHUNK_SIZES=768,1536
MULTI_SCALE_OVERLAP_RATIO=0.1

# Phase 3.5: Chunk Enrichment
CHUNK_ENRICHMENT_ENABLED=false

# Phase 4: Query Transformation
QUERY_TRANSFORMATION_ENABLED=true

# Phase 5: Retrieval Evaluation
RETRIEVAL_EVALUATION_ENABLED=true

# Evaluation endpoints (/api/eval/heuristic and /api/eval/live). Admin-only;
# disabled by default for production safety (issue #237).
EVAL_ENABLED=false

# Phase 6: Tri-Vector Search (DEPRECATED — replaced by Harrier dense embeddings)
TRI_VECTOR_SEARCH_ENABLED=false
FLAG_EMBEDDING_URL=

# =============================================================================
# INGESTION PERFORMANCE TUNING
# =============================================================================
EMBEDDING_CONCURRENT_BATCHES=4
INGESTION_WORKER_COUNT=2
OPTIMIZE_MODE=periodic
OPTIMIZE_INTERVAL_CHUNKS=5000
OPTIMIZE_ON_SHUTDOWN=true
INGESTION_LLM_MODE=instant

# =============================================================================
# JOB LEASE (issue #559) — DB-claimed ingestion lease
# =============================================================================
# Master switch for the DB-claimed lease. ENV-ONLY by design: it selects the
# claim path at process start; flipping it requires a restart so the in-flight
# migration always runs before the new claim path serves work.
INGESTION_JOB_LEASE_ENABLED=true
# Heartbeat renewal interval (seconds) while a job is running. Range 5-600.
JOBS_HEARTBEAT_INTERVAL_SECONDS=30.0
# Janitor reclaim timeout (seconds): a running job whose heartbeat is older
# than this is requeued (or failed at the attempt cap). Must exceed 4x the
# heartbeat interval. Range 15-3600.
JOBS_LEASE_RECLAIM_TIMEOUT_SECONDS=300.0
# Durable attempt cap per job row before the janitor settles it as failed.
# Range 1-20.
JOBS_MAX_ATTEMPTS=3
# Per-queue lease switches for the remaining job queues (issue #559 stages
# 2-4). Same env-only rule as INGESTION_JOB_LEASE_ENABLED: each selects the
# claim path at process start; flipping one requires a restart so the boot
# migration (and, on rollback, the reverse sync) always runs before work is
# served. WIKI_KMS covers both compile queues; DRAFT changes only the claim
# code path (draft_jobs is its own lease store).
WIKI_KMS_JOB_LEASE_ENABLED=true
REINDEX_JOB_LEASE_ENABLED=true
DRAFT_JOB_LEASE_ENABLED=true

# =============================================================================
# VECTOR SEARCH CONFIGURATION
# =============================================================================
# Maximum concurrent vector search operations (1-64)
VECTOR_SEARCH_CONCURRENCY=32

# Timeout in seconds for search semaphore acquisition (1.0-300.0)
# On timeout, /search and /chat endpoints return HTTP 503
SEARCH_SEMAPHORE_TIMEOUT_SECONDS=30.0

# Timeout in seconds for write lock acquisitions (1.0-300.0)
# Prevents indefinite deadlock if a write operation hangs.
WRITE_LOCK_TIMEOUT_SECONDS=30.0

# =============================================================================
# SHARED INFERENCE ADMISSION (issue #518, Workstream E3)
# =============================================================================
# Per-device admission budgets shared by chat/instant/embedding/reranking/
# vision/background work. Defaults are deliberately generous (>= the
# per-process semaphores they complement) so enabling admission does not
# change throughput; tighten only after baseline observation.
# false = zero-overhead pass-through (current behavior).
ADMISSION_ENABLED=true
ADMISSION_CHAT_BUDGET=8
ADMISSION_INSTANT_BUDGET=4
ADMISSION_EMBEDDING_BUDGET=4
ADMISSION_RERANKING_BUDGET=4
ADMISSION_VISION_BUDGET=2
ADMISSION_BACKGROUND_BUDGET=2
# Per-class bound on queued waiters; beyond it requests are rejected (503/SSE
# ADMISSION_REJECTED) instead of queueing unbounded.
ADMISSION_QUEUE_MAX_SIZE=64
# Default queue deadline per admit in seconds. Leave unset (no deadline) or
# set a number, e.g. 30. An EMPTY value would fail float parsing — the
# validator now coerces "" to unset, but keep this commented to stay explicit.
# ADMISSION_DEADLINE_SECONDS=30
# Shared admission store for multi-worker/multi-replica deployments.
# Empty = process-local budgets (single-process boundary). Set to a redis://
# URL to share budgets across processes (Redis is already deployed for the
# rate limiter and embedding cache).
ADMISSION_STORE_URL=

# Pydantic Settings key mapping for the sections above (lowercase settings
# attribute = uppercase env var; pydantic matches env vars case-insensitively):
# admission_enabled=<ADMISSION_ENABLED>
# admission_chat_budget=<ADMISSION_CHAT_BUDGET>
# admission_instant_budget=<ADMISSION_INSTANT_BUDGET>
# admission_embedding_budget=<ADMISSION_EMBEDDING_BUDGET>
# admission_reranking_budget=<ADMISSION_RERANKING_BUDGET>
# admission_vision_budget=<ADMISSION_VISION_BUDGET>
# admission_background_budget=<ADMISSION_BACKGROUND_BUDGET>
# admission_queue_max_size=<ADMISSION_QUEUE_MAX_SIZE>
# admission_deadline_seconds=<ADMISSION_DEADLINE_SECONDS>
# admission_store_url=<ADMISSION_STORE_URL>
# telemetry_enabled=<TELEMETRY_ENABLED>
# telemetry_registry_dir=<TELEMETRY_REGISTRY_DIR>

# =============================================================================
# TELEMETRY (issue #518, Workstream E3)
# =============================================================================
# Turn correlation ids, measured stage/queue/provider metrics and the
# /metrics endpoint. false = inert (no outbound correlation headers, no
# ragapp_* samples). OTLP/OTel export is an optional extra (see
# docs/operations.md).
TELEMETRY_ENABLED=true
# Shared shard directory for multiprocess /metrics aggregation. Empty =
# single-process counters. When running multiple workers/replicas, point
# every worker at ONE shared writable directory so /metrics sums all shards.
TELEMETRY_REGISTRY_DIR=

# =============================================================================
# BACKUP ENCRYPTION KEY (issue #518, Workstream E3)
# =============================================================================
# scripts/backup_set.py encrypts the app.db snapshot with AES-GCM and
# scripts/restore.py decrypts it; both read the key from AES_KEY (or the
# versioned AES_KEY_V1 form) via SecretManager. REQUIRED for both commands
# on a host that runs them — set the SAME value on backup and restore
# hosts, and see docs/operations.md: only app.db is encrypted; the
# lancedb/vault/draft-room trees in a set are plaintext.
# AES_KEY=<64-char-hex-or-32-byte-base64>
# AES_KEY_VERSION=v1

# =============================================================================
# DOCUMENT-ACTION AUDIT HMAC KEY (issue #561)
# =============================================================================
# The document_actions audit log (upload/read/delete/retry) HMAC-signs every
# row via SecretManager. Optional: when AUDIT_HMAC_KEY (or the versioned
# AUDIT_HMAC_KEY_V1 form) is unset, the key is derived from JWT_SECRET_KEY
# or ADMIN_SECRET_TOKEN — the same derivation the security_audit_log table
# uses — so audit rows are always written. Set a dedicated key (>=32 bytes,
# differing from the JWT/admin secrets) to key the two audit tables
# independently; rotating it does not invalidate past rows. Caveats: the
# document_actions digests are write-only today (no runtime path re-verifies
# them, and the table stores no key version), so rotation safety means old
# rows keep their recorded digest rather than remaining verifiable; and while
# the fallback is active the version label recorded alongside an audit row
# reflects the requested version string, not distinct key material.
# AUDIT_HMAC_KEY=<64-char-hex-or-32-byte-base64>
# AUDIT_HMAC_KEY_V1=<64-char-hex-or-32-byte-base64>

# Active-user cache TTL in seconds (5-300)
ACTIVE_USER_CACHE_TTL_SECONDS=30

# MemoryStore dedicated SQLite connection pool size (>= 5)
MEMORY_STORE_POOL_SIZE=10

# Main application SQLite connection pool size (>= 1). The shared pool backing
# auth/permission checks and route DB access. Sized at startup before any other
# get_pool() caller can run (see lifespan). Raise for heavier concurrent load.
DB_POOL_MAX_SIZE=10

# =============================================================================
# LEGACY/DEPRECATED SETTINGS (Still supported for backward compatibility)
# =============================================================================
# [DEPRECATED] Use CHUNK_SIZE_CHARS instead
CHUNK_SIZE=512

# [DEPRECATED] Use CHUNK_OVERLAP_CHARS instead
CHUNK_OVERLAP=50

# [DEPRECATED] Use RETRIEVAL_TOP_K instead
MAX_CONTEXT_CHUNKS=10
VECTOR_TOP_K=10

# [DEPRECATED] Use MAX_DISTANCE_THRESHOLD instead
RAG_RELEVANCE_THRESHOLD=0.1

# =============================================================================
# FILE UPLOAD SECURITY
# =============================================================================
# Maximum file upload size in MB
MAX_FILE_SIZE_MB=100

# Allowed file extensions for upload (comma-separated). Standalone raster image
# formats (.png/.jpg/.jpeg/.gif/.bmp/.tif/.tiff/.webp) are enabled by default and
# are decoded/content-verified at upload (issue #460).
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx,.csv,.xls,.xlsx,.json,.sql,.py,.js,.ts,.html,.css,.xml,.yaml,.yml,.log,.png,.jpg,.jpeg,.gif,.bmp,.tif,.tiff,.webp

# Multimodal artifact storage bounds (issue #460). Binary assets are confined
# per-vault and hardened against decompression bombs / oversize generations.
# MAX_ASSET_PIXELS=50000000
# MAX_ASSET_FRAMES=64
# MAX_ASSETS_PER_GENERATION=256
# MAX_ASSET_BYTES_PER_GENERATION=536870912

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# AUTO-SCAN CONFIGURATION
# =============================================================================
# Enable automatic periodic scanning of data directory for new files
AUTO_SCAN_ENABLED=true
# Interval in minutes between automatic scans
AUTO_SCAN_INTERVAL_MINUTES=60

# =============================================================================
# MAINTENANCE MODE
# =============================================================================
# Enable maintenance mode (forces RAG queries into memory-only fallback;
# does NOT block document uploads or writes — those are controlled
# separately via system_flags through MaintenanceService.set_flag)
MAINTENANCE_MODE=false

# =============================================================================
# IMAP EMAIL INGESTION CONFIGURATION
# =============================================================================
# Enable email ingestion via IMAP (requires valid IMAP settings below)
IMAP_ENABLED=false
# IMAP server hostname (e.g., mail.yourdomain.com)
IMAP_HOST=
# IMAP server port (default: 993 for SSL, 143 for non-SSL)
IMAP_PORT=993
# Use SSL/TLS for IMAP connection (true for port 993, false for port 143)
IMAP_USE_SSL=true
# IMAP account username (e.g., ragbot@yourdomain.com)
IMAP_USERNAME=
# IMAP account password
IMAP_PASSWORD=
# Mailbox to poll (default: INBOX)
IMAP_MAILBOX=INBOX
# Polling interval in seconds (default: 60)
IMAP_POLL_INTERVAL=60
# Maximum attachment size to process (in bytes, default: 10MB)
IMAP_MAX_ATTACHMENT_SIZE=10485760

# =============================================================================
# DRAFT ROOM CONFIGURATION
# =============================================================================
# Master switch for Draft Room (private drafting projects). Disabled by default:
# while false, capability discovery and owner cleanup (list / cancel / delete)
# remain available, but create / edit / upload return 503 draft_room_disabled.
DRAFT_ROOM_ENABLED=false
# Maximum number of uploaded inputs per Draft Room project
DRAFT_MAX_INPUTS=10
# Maximum total raw input bytes per project, in MB (per-file MAX_FILE_SIZE_MB still applies)
DRAFT_MAX_TOTAL_INPUT_MB=250
# Aggregate cap on normalized parsed characters across a project's ready inputs
DRAFT_MAX_TOTAL_PARSED_CHARS=500000
# Wall-clock limit for a single input extraction job, in seconds
DRAFT_PARSE_TIMEOUT_SECONDS=300
# Rate limit for Draft Room input uploads
DRAFT_UPLOAD_RATE_LIMIT=20/minute
# Poll interval for the durable Draft Room job processor, in seconds
DRAFT_POLL_INTERVAL_SECONDS=2.0

# Draft Room pipeline (issue #436, SPEC.md section 15)
# Comma-separated exact normalized origins (scheme://host:port) allowed to
# receive ordinary-tier Draft Room model content. Empty blocks compile.
DRAFT_ALLOWED_MODEL_ORIGINS=
# Editorial desk endpoint for draft-room copy/standards/fact stages.
# Routes these stages away from the primary thinking model so reasoning-loop
# prone models cannot wedge editorial stages. Falls back to the thinking
# client (OLLAMA_CHAT_URL/CHAT_MODEL) when unset.
# DRAFT_EDITORIAL_CHAT_URL=http://llm-host:8003
# DRAFT_EDITORIAL_CHAT_MODEL=qwen38-27b
# Stricter exact-origin allowlist required for the 'sensitive' tier, in
# addition to DRAFT_ALLOWED_MODEL_ORIGINS. Empty blocks sensitive-tier compile.
DRAFT_SENSITIVE_ALLOWED_MODEL_ORIGINS=

# Multimodal artifact enrichment (issue #461) — default OFF, fail-closed.
# No external multimodal provider is contacted until global enablement AND a per-vault
# opt-in AND this exact-origin allowlist AND SSRF safety all hold.
MULTIMODAL_ENRICHMENT_ENABLED=false
# Comma-separated exact normalized origins (scheme://host:port) allowed to receive
# vault artifact content for multimodal enrichment. Empty (default) fails closed.
MULTIMODAL_ALLOWED_MODEL_ORIGINS=
# OpenAI-compatible multimodal /chat/completions base URL. Empty when disabled.
MULTIMODAL_CHAT_URL=
# Multimodal model name passed to the enrichment endpoint. Empty when disabled.
MULTIMODAL_MODEL=
# Logical mode label reported in safe provider snapshots/audit (thinking/instant)
MULTIMODAL_MODE=thinking
# Per-call timeout for a multimodal enrichment request
MULTIMODAL_TIMEOUT_SECONDS=60.0
# Maximum concurrent multimodal enrichment calls
MULTIMODAL_CONCURRENCY=2
# Maximum typed assets enriched together in one request batch
MULTIMODAL_MAX_ASSETS_PER_BATCH=4
# Per-asset byte cap loaded for enrichment
MULTIMODAL_MAX_ASSET_BYTES=10485760
# Total per-request payload byte cap
MULTIMODAL_MAX_TOTAL_PAYLOAD_BYTES=41943040
# Decoded image pixel cap per asset (width*height)
MULTIMODAL_MAX_PIXELS=4000000
# Maximum enrichment attempts per artifact before permanent failure
MULTIMODAL_MAX_ATTEMPTS=3
# Version identifiers (part of the enrichment fingerprint)
MULTIMODAL_PROMPT_VERSION=v1
MULTIMODAL_SCHEMA_VERSION=v1
MULTIMODAL_IMPL_VERSION=1
# Query-time vision master switch (issue #462) — default OFF. When ON, selected
# authorized artifact winners MAY be sent to the multimodal provider for
# query-conditioned observations AFTER retrieval/rerank/distill/pack. Also
# requires MULTIMODAL_ENRICHMENT_ENABLED, per-vault opt-in, and the exact-origin
# allowlist + SSRF gates to hold at call time.
MULTIMODAL_QUERY_VISION_ENABLED=false

# Maximum outline sections a compile job may produce
DRAFT_MAX_SECTIONS=12
# Number of revisions allowed for each bounded editorial (lint/copy/standards) loop
DRAFT_QA_RETRY_LIMIT=2
# Total wall-clock budget, in seconds, for one compile job. Against
# always-reasoning model deployments (whole answer emitted in a reasoning
# phase before content), streaming stage calls can legitimately run many
# minutes each and a ~20-call compile can exceed this default — deployments
# on such backends should raise it (the #652 qualification ran at 7200).
DRAFT_JOB_TIMEOUT_SECONDS=1800
# Hard per-job cap on model calls across every compile stage
DRAFT_JOB_MAX_MODEL_CALLS=40
# Rate limit for Draft Room compile and retry requests, per user
DRAFT_COMPILE_RATE_LIMIT=5/minute
# Maximum sources retrieved per research facet
DRAFT_RESEARCH_RETRIEVAL_LIMIT=8
# Maximum automatic retries for a transient provider/retrieval error inside one compile job
DRAFT_TRANSIENT_RETRY_LIMIT=2
# Default curated-boilerplate rule version applied by the deterministic lint stage
DRAFT_BOILERPLATE_RULE_VERSION=1
# Maximum automatic rewrite attempts the lint stage may apply
DRAFT_LINT_REWRITE_LIMIT=2
# Default logical model mode ("instant" or "thinking") for compile stages
DRAFT_DEFAULT_LOGICAL_MODE=thinking

# =============================================================================
# CANVAS CONFIGURATION (issue #509)
# =============================================================================
# Versioned code/document canvas master switch. While false every canvas route
# returns 503 canvas_disabled and the frontend entry points stay hidden.
# Purely additive — chat behavior is untouched either way.
CANVAS_ENABLED=true
# Maximum artifact content size in KB (create + save both enforce it)
CANVAS_MAX_ARTIFACT_KB=512
CANVAS_MAX_VERSIONS=500
