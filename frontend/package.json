{
  "name": "meridian-frontend",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "vitest run src/a11y.smoke.test.tsx",
    "test:coverage": "vitest run --coverage src/lib/api src/stores",
