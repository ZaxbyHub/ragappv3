{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/lib/api/**/*.ts",
    "src/hooks/**/*.ts",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 30,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ]
}
